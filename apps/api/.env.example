NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://showtime:showtime@localhost:5432/showtime
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=showtime
MINIO_SECRET_KEY=showtime-secret
MINIO_BUCKET=showtime
BETTER_AUTH_SECRET=replace-with-a-local-secret
# Twilio Verify service (SMS). Keep all credentials on the API server.
TWILIO_ACCOUNT_SID=AC_replace_with_account_sid
TWILIO_AUTH_TOKEN=replace_with_auth_token
TWILIO_VERIFY_SERVICE_SID=VA_replace_with_verify_service_sid
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_replace-me
FEATURE_NATIVE_BOOKING=true
FEATURE_PAYMENTS=true
FEATURE_ADVERTISING=false
PILOT_REGIONS=Lisbon,Setúbal
PILOT_VENUE_PARTNER=
